# ============================================================
# Tredev Astro — AI Core
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================

# --- OpenRouter (LLM) ---------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers shown on openrouter.ai activity
OPENROUTER_APP_URL=https://tredevastro.com
OPENROUTER_APP_TITLE=Tredev Astro AI

# --- Models (per role; every LLM call goes through llm_factory) ---
# Main conversational turn
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Used when the main model errors out or times out
OPENROUTER_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Intent classification (cheap + fast is enough)
CLASSIFIER_MODEL=mistralai/mistral-small-3.2-24b-instruct
# LLM-as-judge for response quality. Deliberately a DIFFERENT model from
# OPENROUTER_MODEL so the generator is not grading its own homework.
EVALUATOR_MODEL=google/gemini-2.0-flash-001

MAIN_TEMPERATURE=0.7
MAIN_MAX_TOKENS=700
CLASSIFIER_TEMPERATURE=0.0
EVALUATOR_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# --- Pricing (USD per 1,000,000 tokens) ----------------------
# Cost estimates only. Kept in config, never in business logic.
# Format: "model_id=input_price:output_price", comma separated.
# Any model not listed falls back to DEFAULT_*_PRICE_PER_1M.
MODEL_PRICES=meta-llama/llama-3.3-70b-instruct=0.12:0.30,mistralai/mistral-small-3.2-24b-instruct=0.05:0.10,google/gemini-2.0-flash-001=0.10:0.40
DEFAULT_INPUT_PRICE_PER_1M=0.0
DEFAULT_OUTPUT_PRICE_PER_1M=0.0

# --- Pinecone (astrology KNOWLEDGE only — never user kundlis) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tredev-astro-knowledge
PINECONE_NAMESPACE=astrology-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone-hosted embedding model (no separate embedding provider needed)
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
RAG_TOP_K=6
RAG_MIN_SCORE=0.10
RAG_RELATIVE_MIN_SCORE=0.55

# --- Upstash Redis (conversation + session state) ------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# How many past messages are kept in Redis per session
HISTORY_MAX_MESSAGES=40
# How many of those are actually sent to the LLM
HISTORY_WINDOW=8
SESSION_TTL_SECONDS=604800
CHART_CACHE_TTL_SECONDS=86400

# --- Kundli source -------------------------------------------
# "sample"  -> data/sample_kundli.json (terminal testing, default)
# "backend" -> live POST {TREDEV_BACKEND_URL}/api/calculators/kundli-full
KUNDLI_SOURCE=sample
TREDEV_BACKEND_URL=http://localhost:4000

# --- Runtime -------------------------------------------------
DEFAULT_SESSION_ID=test-session-001
DEFAULT_USER_ID=test-user-001
LOG_LEVEL=INFO
LOG_FILE=logs/ai-core.jsonl
ENABLE_RAG=true
ENABLE_EVALUATION=true

# --- HTTP API ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call /chat from a browser.
# "*" is a DEV default only - list your real origins in production.
API_CORS_ORIGINS=*
# vedic_general | love_relationships | career_finance | marriage_compatibility
DEFAULT_PERSONA_ID=vedic_general
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
MAX_QUESTION_CHARS=2000

# --- Offline knowledge ingestion (PDF path only) -------------
# The curated .txt files split on their own headings and ignore these.
# Approximate tokens; converted to characters with CHARS_PER_TOKEN.
CHUNK_SIZE=500
CHUNK_OVERLAP=60
CHARS_PER_TOKEN=4

# --- LLM provider -------------------------------------------
# Which upstream serves the chat models.
#   openrouter : production. One key, many vendors.
#   gemini     : testing. Google direct, via their OpenAI-compatible
#                endpoint, so no extra SDK is needed.
LLM_PROVIDER=openrouter

# --- Gemini (only needed when LLM_PROVIDER=gemini) -----------
# Key from https://aistudio.google.com/apikey  (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=
# Direct Google model ids have no vendor prefix, unlike OpenRouter's
# "google/gemini-2.5-flash".
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
# No OpenAI model is reachable on Google's endpoint, so the judge is a
# Gemini model here rather than the gpt-4o-mini used via OpenRouter.
GEMINI_EVALUATOR_MODEL=gemini-2.5-flash-lite
