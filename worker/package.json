{
  "name": "ai-playground-worker",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/node/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs --log-level=warning",
    "start": "node dist/server.mjs",
    "dev": "wrangler dev",
    "dev:node": "npm run build && node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node scripts/migrate.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@noble/hashes": "^2.4.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "hono": "^4.13.19",
    "postgres": "^4.1.1",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/tz-lookup": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "wrangler": "^4.163.0"
  },
  "description": "AI Playground API: Hono app served by Express on Node (Render), also deployable as a Cloudflare Worker",
  "engines": {
    "node": ">=22"
  }
}
